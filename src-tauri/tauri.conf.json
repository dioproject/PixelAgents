{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PT Pixel Sinergi Nusantara",
  "version": "0.1.0",
  "identifier": "com.pixelsinergi.corporate",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PT Pixel Sinergi Nusantara Tbk — CEO Dashboard",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
